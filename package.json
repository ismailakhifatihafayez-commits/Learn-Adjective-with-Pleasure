{
  "name": "adjective-learning-platform",
  "version": "1.0.0",
  "description": "Interactive English-Bengali Adjective Learning & Quiz Platform featuring 1,260 curated vocabulary words, 3D flashcards, Web Speech voice search, audio pronunciation, timed quizzes, milestone badges, and a Gemini AI Tutor.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "english-learning",
    "bengali",
    "adjectives",
    "vocabulary",
    "quiz-app",
    "flashcards",
    "web-speech-api",
    "gemini-ai",
    "react",
    "typescript",
    "tailwindcss"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
